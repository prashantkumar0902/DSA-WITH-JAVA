// 2nd this is the hollow rectangle //


import java.util.Scanner;

public class main {
    public static void main(String args[]) {
     int  n = 4;
     int m = 5;

//hollow Rectangle
     
     for (int i = 1; i <= n; i++){
        for(int j = 1; j <= m; j++){
           if(i==1 || j==1 || i==n || j==m) {
                System.out.print("*");
            } else {
                System.out.print(" ");

            }
         }
        System.out.println();
      }    
   }
}



